{
  "name": "fresh-prints",
  "version": "1.0.0",
  "private": true,
  "description": "Private newspaper-style daily tech news digest",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "node src/index.js",
    "selftest": "node scripts/selftest.js",
    "ingest": "node scripts/trigger-ingest.js",
    "publish": "node scripts/trigger-publish.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "fast-xml-parser": "^5.10.1",
    "google-auth-library": "^11.0.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "resend": "^4.1.2",
    "yahoo-finance2": "^4.0.0"
  }
}
