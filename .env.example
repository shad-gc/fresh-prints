# Fresh Prints — environment template
# Copy to .env for local development. Never commit .env.

NODE_ENV=development
PORT=8080

# SQLite path (local default; production uses /data/prints.db via Cloud Run volume)
DATABASE_URL=./prints.db

# Session signing secret (openssl rand -hex 32)
SESSION_SECRET=change-me-locally

# GitHub OAuth — use the *dev* OAuth app locally
# (callback: http://localhost:PORT/auth/callback)
GH_CLIENT_ID=
GH_CLIENT_SECRET=

# Comma-separated GitHub usernames allowed to sign in (compared lowercase)
ALLOWED_GITHUB_USERNAMES=

# Optional local-only: skip GitHub OAuth (never set in production)
# DEV_BYPASS_AUTH=1

# Anthropic
ANTHROPIC_API_KEY=
# Optional override; default claude-sonnet-4-5
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Resend
RESEND_API_KEY=
# Verified sender in Resend (e.g. Fresh Prints <digest@yourdomain.com>)
DIGEST_EMAIL_FROM=
# Recipient for the morning edition
DIGEST_EMAIL_TO=

# Public URL of this app (used in email footer links). Local: http://localhost:8080
APP_URL=http://localhost:8080

# Cloud Run service URL — audience for identity-token verification on
# /api/ingest and /api/publish. Unused in development (verification skipped).
CLOUD_RUN_SERVICE_URL=

# Comma-separated service-account emails allowed to call /api/ingest and
# /api/publish. Audience verification alone is not authorization — any SA in
# any GCP project can mint a token for your URL. Unused in development.
# e.g. github-deployer@PROJECT_ID.iam.gserviceaccount.com
ALLOWED_INVOKER_EMAILS=
